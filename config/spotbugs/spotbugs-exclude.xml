<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/4.8.4"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/4.8.4 https://raw.githubusercontent.com/spotbugs/spotbugs/4.8.4/spotbugs/etc/findbugsfilter.xsd">

    <!-- Ignore internal representation exposure on immutable records and builder components -->
    <Match>
        <Package name="~dev\.nthings\.tessera\..*"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Permit runtime exception rethrow for multi-threaded future unwrapping -->
    <Match>
        <Class name="dev.nthings.tessera.compiler.SiteCompiler"/>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
    </Match>

    <!-- Preserve callback exception types after attaching component context. -->
    <Match>
        <Class name="dev.nthings.tessera.compiler.Expansion"/>
        <Method name="callback"/>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
    </Match>
</FindBugsFilter>
